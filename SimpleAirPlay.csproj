<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <Version>5.0.0</Version>
    <AssemblyTitle>Simple AirPlay</AssemblyTitle>
    <Product>Simple AirPlay</Product>
    <Description>Premium AirPlay Receiver for Windows</Description>
    <Company>Simple AirPlay</Company>
    <Copyright>Copyright © 2026 Simple AirPlay</Copyright>

    <!-- MSIX Packaging -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
  </ItemGroup>

  <!-- Engine binaries (uxplay + GStreamer) bundled as content -->
  <ItemGroup>
    <Content Include="engine\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
