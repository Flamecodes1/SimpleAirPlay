<Window x:Class="SimpleAirPlay.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über Simple AirPlay" Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True">
    
    <Border CornerRadius="15" Background="#1E1E1E" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
                <Path Data="M 4,4 L 28,4 C 29.1,4 30,4.9 30,6 L 30,22 C 30,23.1 29.1,24 28,24 L 21,24 L 16,18 L 11,24 L 4,24 C 2.9,24 2,23.1 2,22 L 2,6 C 2,4.9 2.9,4 4,4 Z M 16,19 L 23,28 L 9,28 Z"
                      Fill="#00D4FF" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Simple AirPlay" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Version 5.0 (Store Edition)" Foreground="#A0FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,15">
                        Simple AirPlay ist eine moderne, native Benutzeroberfläche für die Open-Source AirPlay-Engine "UxPlay".
                    </TextBlock>

                    <TextBlock Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,5">
                        Open Source &amp; Lizenzen
                    </TextBlock>
                    <TextBlock Foreground="#A0FFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                        Diese Software nutzt UxPlay und GStreamer, welche unter der GNU General Public License v3.0 (GPLv3) stehen. 
                        Der Quellcode der Engine und dieser Anwendung muss auf Anfrage bereitgestellt werden.
                    </TextBlock>

                    <!-- Links -->
                    <Button Content="GPLv3 Lizenz lesen" Click="License_Click"
                            Foreground="#00D4FF" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,5"/>
                    <Button Content="UxPlay Quellcode (GitHub)" Click="GitHub_Click"
                            Foreground="#00D4FF" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="Schließen" Click="Close_Click"
                    Foreground="White" Background="#33FFFFFF" BorderThickness="0" 
                    Padding="10,8" Cursor="Hand" Margin="0,20,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
